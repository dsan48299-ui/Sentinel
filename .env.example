# PayPal Sandbox — secret stays server-side
NEXT_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Supabase — anon key is returned only by the same-origin config endpoint
NEXT_SUPABASE_URL=
NEXT_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway — production uses Vercel OIDC automatically.
# Set an AI Gateway API key only for local development.
AI_GATEWAY_API_KEY=
CAPITALFLOW_AI_MODEL=openai/gpt-5.5
